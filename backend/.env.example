# ---- AI (Groq is tried first; Ollama is only a fallback) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Leave Ollama unset in production unless you host it somewhere reachable
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ---- Speakatoo TTS ----
SPEAKATOO_API_KEY=
SPEAKATOO_USERNAME=
SPEAKATOO_PASSWORD=
SPEAKATOO_VOICE_ID_EN=
SPEAKATOO_VOICE_ID_HI=
SPEAKATOO_VOICE_ID_PA=
SPEAKATOO_VOICE_ID_GU=
SPEAKATOO_TTS_FORMAT=mp3

# ---- Deployment ----
# Comma-separated frontend URLs allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Directory for JSON data + TTS cache. Use a persistent disk path in production.
# DATA_DIR=/var/data
